#!/usr/bin/env bash
# https://github.com/daimh/daiker
set -fEeuo pipefail
trap "exit 1" TERM

function die {
	# 20260328
	local UsageBuild="Build a base image (similar to a Docker image)"
    local UsageRun="Create and run an overlay image based on a existing base 
        or overlay image (similar to a Docker container)"
	local UsageInspect="Inspect relationships between images"
	local OptBRI="OPTIONS
    -h, --help
        Show this help message
    --version
        Show version information
    -v
        Enable verbose output"
	local OptBR="
    -c, --cpu=CPU
        Number of CPUs (default: 2)
    -r, --ramsize=RAMSIZE
        Memory size in GB (default: 4)
    -i, --iso=FILE
        ISO file to use as as the CD-ROM
    -d, --disable-public-net
        Disable public networking. The VM will not have Internet access.
    -e, --enable-private-net=random|11:22:33
        Add a NIC with a specfic or random MAC address to share a private
        network with other VMs using this option. The MAC address will be
        prefixed with '52:54:00'.
    -M, --mount=DIR
        Mount one or more host directories inside the VM. Example:
            mount -t 9p -o msize=1048576 daiker-0 /mnt
        where 'daiker-0' refers to the first -M option.
        Note: Default CentOS and Windows images may not support this
        feature.
    -T, --tcp-ports=VMPORT| VMPORT-HOSTPORT
        Forward TCP port HOSTPORT on the host to VMPORT on the VM
    -U, --udp-ports=VMPORT| VMPORT-HOSTPORT
        Forward UDP port HOSTPORT on the host to VMPORT on the VM
    -D, --display=gtk|vnc|[VncDisplayNum]|none|nographic
        Default: gtk (requires X server)
    -Q, --qemu-parameters=PARAMS
        Additional QEMU parameters (can be used multiple times).
        Example:
          sudo chown \$USER /dev/bus/usb/003/006
          daiker run -Q \ 
            \"-device usb-ehci,id=ehci -device usb-host,hostbus=3,hostaddr=6\" \ 
            test.qcow2"
	local OptB="
    -H, --hda-size=SIZE
        Disk size in GB (default: 50), Only used with the 'build'"
	local OptR="
    -b, --base=BASE
        A backing image used to create a new overlay VM. can be the 
		output of 'daiker build' or 'daiker run'"
	local Copyright="AUTHOR
    Manhong Dai

COPYRIGHT
    © University of Michigan 2002-2026

LICENSE
    MIT"
	# PRINTF
	if [ "$#" -eq 1 ]
	then
		printf "$1\n"
	elif [ "$#" -eq 0 ]
	then
		printf "daiker — A Docker-like VM tool based on QEMU and KVM\n
USAGE
    daiker <command> [options]... [file]...\n
COMMANDS
    build
        %s\n
    run
        %s\n
    inspect
        %s\n
OPTIONS
    -h, --help
        Show this help information\n\n%s\n" \
			"$UsageBuild" "$UsageRun" "$UsageInspect" "$Copyright"
	elif [ "$2" = build ]
	then
		printf "daiker build — %s\n
SYNOPSIS
    daiker build [options]... [file]\n
EXAMPLES
    daiker build -H 50 -i ubuntu-18.04.5-live-server-amd64.iso ubuntu18.qcow2\n
%s%s%s\n\n%s\n" "$UsageBuild" "$OptBRI" "$OptBR" "$OptB" "$Copyright"
	elif [ "$2" = run ]
	then
		printf "daiker run — %s\n
SYNOPSIS
    daiker run [options]... [file]\n
EXAMPLES
    daiker run -b ubuntu18.qcow2 ubuntu18.qcow2
    daiker run -T 22 -T 80 ubuntu18.qcow2
    wget https://dl-cdn.alpinelinux.org/alpine/edge/releases/x86_64/netboot \ 
        /vmlinuz-virt
    wget https://dl-cdn.alpinelinux.org/alpine/edge/releases/x86_64/netboot \ 
        /initramfs-virt
    daiker run -Q '-kernel vmlinuz-virt' -Q '-initrd initramfs-virt' -Q \ 
        '-append alpine_repo=https://dl-cdn.alpinelinux.org/alpine/v3.16 \ 
        /main[TAB]modloop=https://dl-cdn.alpinelinux.org/alpine/edge \ 
        /releases/x86_64/netboot/modloop-virt' \ 
        /dev/null # Please replace [TAB] with TAB\n
%s%s%s\n\n%s\n" "$UsageRun" "$OptBRI" "$OptBR" "$OptR" "$Copyright"
	elif [ "$2" = inspect ]
	then
		printf "daiker inspect — %s\n
SYNOPSIS
    daiker inspect [options]... [file]...\n
EXAMPLES
    daiker inspect .
    daiker inspect *.qcow2 images/\n\n%s\n\n%s\n" \
		"$UsageInspect" "$OptBRI" "$Copyright"
	fi
	Pgid=$(ps -o pgid= $$ | tr -d " ")
	[ $(cat /proc/$Pgid/task/$Pgid/children | wc -w) -lt 2 ] \
		&& exit 1 \
		|| kill 0
}

function get_free_ports {
	[ "$1" != "tcp" -a "$1" != "udp" ] && die "ERR-015: contact developer"
	export LC_ALL=C
	sleep 0.$(($RANDOM%10))
	join -v 1 <(seq $2 $3) \
		<(ss -4ln${1:0:1} |tail -n +2 |awk '{print $4}' |cut -d : -f 2 |sort) \
		| shuf | head -n $4
}

function get_hostfwd {
	Proto=$1
	shift
	[ -z "$1" ] && return
	COUNT=$(echo "$@" | sed -e "s/ /\n/g" | wc -l)
	paste <(get_free_ports $Proto 40000 50000 $COUNT) \
		<(echo "$@" | sed -e "s/ /\n/g") \
		| awk -v Proto=$Proto '{if (NR>1) printf ","; \
			printf "hostfwd=%s::%s-:%s", Proto, $1, $2}'
}

function version {
	die 20260425
}

[ $# -gt 0 ] || die
[ "$1" != "-h" -a "$1" != "--help" -a "$1" != "help" ] || die
Command=$1
OptShort="hvc:r:i:de:M:T:U:D:Q:"
OptLong="help,version,cpu:,ram:,iso:,disable-public-net,enable-private-net:\
	,mount:,tcp-ports:,udp-ports:display:,qemu-parameters"
shift || die
if [ "$Command" = "build" ]
then
	OptShort="${OptShort}H:"
	OPTS=$(getopt -o $OptShort --long "$OptLong,hda-size:" -n daiker -- "$@")
elif [ "$Command" = "run" ]
then
	OptShort="${OptShort}b:"
	OPTS=$(getopt -o $OptShort --long "$OptLong,base:" -n daiker -- "$@")
elif [ "$Command" = "inspect" ]
then
	OPTS=$(getopt -o "hv" --long "help,version" -n daiker -- "$@")
elif [ "$Command" = "--version" ]
then
	version
elif [ "$Command" = "--help" -o "$Command" = "-h" ]
then
	die
else
	die "ERR-001: unsupported daiker command"
fi
Cpu=2
Base=""
Iso=""
RamSize=4
HdSize=50
Vnc=no
EnablePrivateNets=()
DisablePublicNet=""
MountDirs=()
TcpPorts=()
UdpPorts=()
PrvNet=""
PubNet="-device virtio-net-pci,netdev=n9 -netdev user,id=n9"
[ -z ${DISPLAY+x} ] && QemuDisplay=vnc || QemuDisplay=gtk
QemuParameters=()
eval set -- "$OPTS"
while :
do
	case "$1" in
		-h | --help)
			die help $Command;;
		--version)
			version ;;
		-v )
			set -x
			shift ;;
		-c | --cpu)
			[ "$2" -eq "$2" ] 2> /dev/null \
				|| die "ERR-021: invalid number: -c $2"
			Cpu=$2
			shift 2 ;;
		-r | --ramsize)
			[ "$2" -eq "$2" ] 2> /dev/null \
				|| die "ERR-022: invalid number: -r $2"
			RamSize=$2
			shift 2 ;;
		-i | --iso)
			Iso=$2
			shift 2 ;;
		-d | --disable-public-net)
			DisablePublicNet=YES
			shift 1 ;;
		-e | --enable-private-net)
			EnablePrivateNets+=($2)
			shift 2 ;;
		-M | --mount)
			MountDirs+=($2)
			shift 2 ;;
		-T | --tcp-ports)
			if [[ "$2" == *"-"* ]]
			then
				IFS=- read VPORT HPORT <<< "$2"
				[ "$HPORT" -eq "$HPORT" ] \
					&& [ "$VPORT" -eq "$VPORT" ] 2> /dev/null \
					|| die "ERR-023: invalid number: -T $2"
				PubNet="$PubNet,hostfwd=tcp::$HPORT-:$VPORT"
			else
				[ "$2" -eq "$2" ] 2> /dev/null \
					|| die "ERR-024: invalid number: -T $2"
				TcpPorts+=($2)
			fi
			shift 2 ;;
		-U | --udp-ports)
			if [[ "$2" == *"-"* ]]
			then
				IFS=- read VPORT HPORT <<< "$2"
				[ "$HPORT" -eq "$HPORT" ] \
					&& [ "$VPORT" -eq "$VPORT" ] 2> /dev/null \
					|| die "ERR-026: invalid number: -U $2"
				PubNet="$PubNet,hostfwd=udp::$HPORT-:$VPORT"
			else
				[ "$2" -eq "$2" ] 2> /dev/null \
					|| die "ERR-027: invalid number: -U $2"
				UdpPorts+=($2)
			fi
			shift 2 ;;
		-D | --display)
			QemuDisplay=$2
			shift 2 ;;
		-Q | --qemu-parameters)
			QemuParameters+=("$2")
			shift 2 ;;
		-b | --base)
			Base=$2
			shift 2 ;;
		-H | --hda-size)
			[ "$2" -eq "$2" ] 2> /dev/null \
				|| die "ERR-025: invalid number: -H $2"
			HdSize=$2
			shift 2 ;;
		--)
			shift
			break ;;
		*)
			break ;;
	esac
done
if [ "$Command" = "inspect" ]
then
	[ $# -gt 0 ] || die "ERR-013: run 'daiker $Command -h/--help'"
	find $@ -type f -exec bash -c "file {} | grep 'QEMU QCOW'" \; \
	| while IFS=: read FName Desc
	do
		Backing="."
		FName=$(realpath --relative-to=. $FName)
		if echo $Desc | grep -q 'has backing file (path'
		then	
			Backing=$(realpath --relative-to=. $(dirname $FName)/$(
				echo $Desc | sed "s/.*has backing file (path //; s/).*//"
			) )
			[ -e "$Backing" ] || Backing="$Backing (MISSING)"
		fi
		echo -e "$Backing\t$FName"
	done | sort -u | awk -F "\t" '
{
    parent = $1
    child = $2
    children[parent] = children[parent] " " child
    nodes[parent] = 1
    nodes[child] = 1
    has_parent[child] = 1
}
END {
	PROCINFO["sorted_in"] = "@ind_str_asc"
    for (n in nodes) {
        if (!(n in has_parent)) {
            print n
            print_tree(n, "", 1)
        }
    }
}
function print_tree(node, prefix, is_root, arr, i, count, child, new_prefix) {
    count = split(children[node], arr, " ")
    for (i in arr) {
        child = arr[i]
        if (i == count) {
            print prefix "└── " child
            new_prefix = prefix "    "
        } else {
            print prefix "├── " child
            new_prefix = prefix "│   "
        }
        print_tree(child, new_prefix, 0)
    }
}'
	exit
fi
[ $# -eq 1 ] || die "ERR-002: run 'daiker $Command -h/--help'"
Image=$1
[ ! -z "$Image" ] || die "ERR-003: missing Image"
if [ "$Image" = "/dev/null" ]
then
	Hda=""
else
	Hda="-hda $Image"
fi
Mounts=""
for ((Idx=0; Idx<${#MountDirs[@]}; Idx++))
do
	[ -d ${MountDirs[$Idx]} ] || die "ERR-020: no such dir ${MountDirs[$Idx]}"
	Mounts="$Mounts -virtfs local,id=daiker-$Idx,path=${MountDirs[$Idx]},\
		security_model=none,multidevs=remap,mount_tag=daiker-$Idx"
done
for ((i=0; i<${#EnablePrivateNets[@]}; i++))
do
	if [ "${EnablePrivateNets[$i]}" = "random" ]
	then
		MacAddr=$(printf "52:54:00:%02x:%02x:%02x\n" $(( $RANDOM % 256)) \
			$(( $RANDOM % 256)) $(( $RANDOM % 256)) )
	else
		MacAddr=$(printf "52:54:00:${EnablePrivateNets[$i]}\n")
	fi
	PrvNet+=" -device virtio-net-pci,netdev=n$i,mac=$MacAddr -netdev \
socket,id=n$i,mcast=230.$(($(id -u) % 239)).$(($(id -u) % 241)).\
$(($(id -u) % 251)):$(($(id -u) % 9973 + 30000+$i)),localaddr=127.0.0.1"
done
if [[ ${#TcpPorts[@]} -gt 0 ]]
then
	[ "$DisablePublicNet" != "YES" ] || die "ERR-006: -T cannot be used with -d"
	HostFwd=$( get_hostfwd tcp ${TcpPorts[@]} )
	[ -n "$HostFwd" ] \
		|| die "ERR-016: faield to get a idle tcp port on physical machine"
	echo "TCP ports: $HostFwd"
	PubNet="$PubNet,$HostFwd"
fi
if [[ ${#UdpPorts[@]} -gt 0 ]]
then
	[ "$DisablePublicNet" != "YES" ] \
		|| die "ERR-030: -U cannot be used with -d"
	HostFwd=$( get_hostfwd udp ${UdpPorts[@]} )
	[ -n "$HostFwd" ] \
		|| die "ERR-017: faield to get a idle udp port on physical machine"
	echo "UDP ports: $HostFwd"
	PubNet="$PubNet,$HostFwd"
fi
if [ "$QemuDisplay" = "gtk" ]
then
	set +u
	[ -n "$DISPLAY" ] \
		|| die "ERR-004: '-D gtk' needs X, or you might want to try '-D vnc'"
	set -u
	QemuDisplay="-display gtk -vga std"
elif [ "$QemuDisplay" = "vnc" ]
then
	Vnc=$(get_free_ports tcp 5900 5999 1)
	[ -z "$Vnc" ] && die "ERR-014: no available vnc port"
	echo "$Image VNC port: $Vnc"
	((Vnc=Vnc-5900)) || :
	QemuDisplay="-display vnc=:$Vnc"
elif [ "$QemuDisplay" = "none" ]
then
	QemuDisplay="-display none"
elif [ "$QemuDisplay" = "nographic" ]
then
	QemuDisplay="-nographic"
else
	set +e
	let Vnc="$QemuDisplay" 2> /dev/null
	set -e
	[ "$Vnc" = "$QemuDisplay" ] \
		|| die "ERR-018: -D should be gtk/vnc/none/nographic or a Vnc number"
	QemuDisplay="-display vnc=:$Vnc"
fi
if [ "$DisablePublicNet" = "YES" ]
then
	PubNet=""
fi
if [ -n "$Iso" ]
then
	[ -f "$Iso" ] || die "ERR-008: no such iso file $Iso"
	Iso="-cdrom $Iso"
fi
if [ "$Command" = "build" ]
then
	if [ "$Image" != "/dev/null" ]
	then
		[ ! -f $Image ] || die "ERR-005: $Image exists"
		[ ! -z "$HdSize" ] || die "ERR-007: missing -H"
		qemu-img create -qf qcow2 $Image ${HdSize}G
	fi
elif [ "$Command" = "run" ]
then
	if [ -n "$Base" ]
	then
		[ -f $Base ] || die "ERR-009: no such file $Base"
		DirName=$(dirname $Image)
		if [ -f $Image ]
		then
			Backing=$(qemu-img info $Image | grep '^backing file: ' \
				| sed -e "s/^backing file: //; s/ (actual path: .*//")
			[ "$(realpath $DirName/$Backing)" = "$(realpath $Base)" ] \
				|| die "ERR-010: overlay image '$Image' already exists, but \
					its base image is '$Backing', instead of '-b $Base'. \
					Either delete the file '$Image' or don't use '-b $Base' \
					in the command."
		else
			[ -d $DirName ] || die "ERR-029: no such directory $DirName"
			[ ! -w $Base ] \
				|| chmod a-w $Base \
				|| echo "Warning: Could not set $Base to read-only. Continuing."
			qemu-img create -qf qcow2 -b $(realpath \
				--relative-to=$DirName $Base) -F qcow2 $Image
		fi
	elif [ "$Image" != "/dev/null" ]
	then
		[ -f $Image ] || die "ERR-011: no such file $Image"
		! fuser $Image \
			|| die "ERR-012: $Image is in use by the process above"
	fi
else
	die
fi
QemuBin=$(command -v qemu-system-x86_64 2>/dev/null) \
	|| QemuBin="$(command -v qemu-kvm 2>/dev/null)" \
	|| QemuBin="$(command -v /usr/libexec/qemu-kvm 2>/dev/null)" \
	|| die "ERR-031: qemu-system-x86_64 or qemu-kvm is missing"
IFS=$' '
$QemuBin -name $Image -cpu host -enable-kvm -usb -device usb-tablet \
	-smp $Cpu -m ${RamSize}G $Hda $Iso $PrvNet $PubNet $Mounts $QemuDisplay \
	${QemuParameters[@]}
