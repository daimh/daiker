#!/usr/bin/env bash
# https://github.com/daimh/daiker
set -fEeuo pipefail
trap "exit 1" TERM

function die {
    local UsageRun="Run a VM with qcow2 images"
	local UsageInspect="Inspect relationships between qcow2 images"
	local OptRI="OPTIONS
    -h, --help
        Show this help message
    --version
        Show version information
    -v
        Enable verbose output"
	local Copyright="AUTHOR
    Manhong Dai
COPYRIGHT
    © University of Michigan 2002-2026
LICENSE
    MIT"
	# PRINTF
	if [ "$#" -eq 1 ]
	then
		printf "$1\n"
	elif [ "$#" -eq 0 ]
	then
		printf "daiker — A Docker-like VM tool based on QEMU and KVM
USAGE
    daiker <command> [options]... [file]...
COMMANDS
    run
        %s
    inspect
        %s
OPTIONS
    -h, --help
        Show this help information
%s\n" "$UsageRun" "$UsageInspect" "$Copyright"
	elif [ "$2" = run ]
	then
		printf "daiker run — %s
SYNOPSIS
    daiker run [options]... [file]... [file=size]... [file:backing]...
EXAMPLES
    ####### Installation with Ubuntu Iso #######
    daiker run -i ubuntu-18.04.5-live-server-amd64.iso ubuntu18.qcow2=50G
    daiker run overlay.qcow2:ubuntu18.qcow2
    daiker run -T 22 -T 80 overlay.qcow2
    #### Cloud image with Rocky Cloud Image ####
    wget https://dl.rockylinux.org/pub/rocky/9/images/x86_64/Rocky-9-GenericCloud-Base.latest.x86_64.qcow2
    sudo virt-customize -a Rocky-9-GenericCloud-Base.latest.x86_64.qcow2 \\
        --root-password password:daiker
    daiker run overlay.qcow2:Rocky-9-GenericCloud-Base.latest.x86_64.qcow2
    ########### Netboot with Alpine ############
    wget https://dl-cdn.alpinelinux.org/alpine/edge/releases/x86_64/netboot/vmlinuz-virt
    wget https://dl-cdn.alpinelinux.org/alpine/edge/releases/x86_64/netboot/initramfs-virt
    daiker run -Q '-kernel vmlinuz-virt' -Q '-initrd initramfs-virt' -Q '-append alpine_repo=https://dl-cdn.alpinelinux.org/alpine/edge/main'\$\'\\\t\''modloop=https://dl-cdn.alpinelinux.org/alpine/edge/releases/x86_64/netboot/modloop-virt'
OPTIONS
    -c, --cpu=CPU
        Number of CPUs (default: 2)
    -r, --ramsize=RAMSIZE
        Memory size in GB (default: 4)
    -i, --iso=FILE
        ISO file to use as as the CD-ROM
    -d, --disable-public-net
        Disable public networking. The VM will not have Internet access.
    -e, --enable-private-net=random|11:22:33
        Add a NIC with a specfic or random MAC address to share a private
        network with other VMs using this option. The MAC address will be
        prefixed with '52:54:00'.
    -M, --mount=DIR
        Mount one or more host directories inside the VM. Example:
            mount -t 9p -o msize=1048576 daiker-0 /mnt
        where 'daiker-0' refers to the first -M option.
        Note: Default CentOS and Windows images may not support this
        feature.
    -T, --tcp-ports=VMPORT| VMPORT-HOSTPORT
        Forward TCP port HOSTPORT on the host to VMPORT on the VM
    -U, --udp-ports=VMPORT| VMPORT-HOSTPORT
        Forward UDP port HOSTPORT on the host to VMPORT on the VM
    -D, --display=gtk|vnc|[VncDisplayNum]|none|nographic
        Default: gtk (requires X server)
    -Q, --qemu-parameters=PARAMS
        Additional QEMU parameters (can be used multiple times).
        Example:
          sudo chown \$USER /dev/bus/usb/003/006
          daiker run -Q \\
            \"-device usb-ehci,id=ehci -device usb-host,hostbus=3,hostaddr=6\" \\
            test.qcow2
%s\n" "$UsageRun" "$Copyright"
	elif [ "$2" = inspect ]
	then
		printf "daiker inspect — %s
SYNOPSIS
    daiker inspect [options]... [file]...
EXAMPLES
    daiker inspect .
    daiker inspect -t 10 *.qcow2 images/
OPTIONS
    -t, --timeout=SECONDS
        kill the find command if it is still running after this duration
%s\n" "$UsageInspect" "$Copyright"
	fi
	Pgid=$(ps -o pgid= $$ | tr -d " ")
	[ $(cat /proc/$Pgid/task/$Pgid/children | wc -w) -lt 2 ] \
		&& exit 1 \
		|| kill 0
}

function get_free_ports {
	[ "$1" != "tcp" -a "$1" != "udp" ] && die "ERR-015: contact developer"
	export LC_ALL=C
	sleep 0.$(($RANDOM%10))
	join -v 1 <(seq $2 $3) \
		<(ss -4ln${1:0:1} |tail -n +2 |awk '{print $4}' |cut -d : -f 2 |sort) \
		| shuf | head -n $4
}

function get_hostfwd {
	Proto=$1
	shift
	[ -z "$1" ] && return
	COUNT=$(echo "$@" | sed -e "s/ /\n/g" | wc -l)
	paste <(get_free_ports $Proto 40000 50000 $COUNT) \
		<(echo "$@" | sed -e "s/ /\n/g") \
		| awk -v Proto=$Proto '{if (NR>1) printf ","; \
			printf "hostfwd=%s::%s-:%s", Proto, $1, $2}'
}

function version {
	die 20260521
}

[ $# -gt 0 ] || die
[ "$1" != "-h" -a "$1" != "--help" -a "$1" != "help" ] || die
Command=$1
shift || die
if [ "$Command" = "run" ]
then
	OptShort="hvc:r:i:de:M:T:U:D:Q:"
	OptLong="help,version,cpu:,ram:,iso:,disable-public-net,enable-private-net:\
,mount:,tcp-ports:,udp-ports:display:,qemu-parameters"
	OPTS=$(getopt -o $OptShort --long "$OptLong" -n daiker -- "$@")
elif [ "$Command" = "inspect" ]
then
	OPTS=$(getopt -o "hvt:" --long "help,version,timeout:" -n daiker -- "$@")
elif [ "$Command" = "--version" ]
then
	version
elif [ "$Command" = "--help" -o "$Command" = "-h" ]
then
	die
else
	die "ERR-001: unsupported daiker command"
fi
Cpu=2
Iso=""
RamSize=4
Vnc=no
EnablePrivateNets=()
DisablePublicNet=""
MountDirs=()
TcpPorts=()
UdpPorts=()
PrvNet=""
PubNet="-device virtio-net-pci,netdev=n9 -netdev user,id=n9"
[ -z ${DISPLAY+x} ] && QemuDisplay=vnc || QemuDisplay=gtk
QemuParameters=()
Timeout=10
eval set -- "$OPTS"
while :
do
	case "$1" in
		-h | --help)
			die help $Command;;
		--version)
			version ;;
		-v )
			set -x
			shift ;;
		-c | --cpu)
			[[ $2 =~ ^[0-9]+$ ]] \
				|| die "ERR-021: invalid number: -c $2"
			Cpu=$2
			shift 2 ;;
		-r | --ramsize)
			[[ $2 =~ ^[0-9]+$ ]] \
				|| die "ERR-022: invalid number: -r $2"
			RamSize=$2
			shift 2 ;;
		-i | --iso)
			Iso=$2
			shift 2 ;;
		-d | --disable-public-net)
			DisablePublicNet=YES
			shift ;;
		-e | --enable-private-net)
			EnablePrivateNets+=($2)
			shift 2 ;;
		-M | --mount)
			MountDirs+=($2)
			shift 2 ;;
		-T | --tcp-ports)
			if [[ "$2" == *"-"* ]]
			then
				IFS=- read VPORT HPORT <<< "$2"
				[[ $HPORT =~ ^[0-9]+$ ]] \
					&& [[ $VPORT =~ ^[0-9]+$ ]] \
					|| die "ERR-023: invalid number: -T $2"
				PubNet="$PubNet,hostfwd=tcp::$HPORT-:$VPORT"
			else
				[[ $2 =~ ^[0-9]+$ ]] \
					|| die "ERR-024: invalid number: -T $2"
				TcpPorts+=($2)
			fi
			shift 2 ;;
		-U | --udp-ports)
			if [[ "$2" == *"-"* ]]
			then
				IFS=- read VPORT HPORT <<< "$2"
				[[ $HPORT =~ ^[0-9]+$ ]] \
					&& [[ $VPORT =~ ^[0-9]+$ ]] \
					|| die "ERR-026: invalid number: -U $2"
				PubNet="$PubNet,hostfwd=udp::$HPORT-:$VPORT"
			else
				[[ $2 =~ ^[0-9]+$ ]] \
					|| die "ERR-027: invalid number: -U $2"
				UdpPorts+=($2)
			fi
			shift 2 ;;
		-D | --display)
			QemuDisplay=$2
			shift 2 ;;
		-Q | --qemu-parameters)
			QemuParameters+=("$2")
			shift 2 ;;
		-t | --timeout)
			[[ $2 =~ ^[0-9]+$ ]] \
				|| die "ERR-032: invalid number: -t $2"
			Timeout=$2
			shift 2 ;;
		--)
			shift
			break ;;
		*)
			break ;;
	esac
done
if [ "$Command" = "inspect" ]
then
	[ $# -gt 0 ] || die "ERR-013: run 'daiker $Command -h/--help'"
	List=$(mktemp)
	trap 'rm -f $List' EXIT
	timeout $Timeout find $@ -type f -exec bash -c \
			"file {} | grep 'QEMU QCOW'" \; > $List \
		|| die "ERR-033: Search timed out after $Timeout second. Try \
increasing it with the -t."
	cat $List | while IFS=: read Filename Desc
	do
		Backing="."
		Filename=$(realpath --relative-to=. $Filename)
		if echo $Desc | grep -q 'has backing file (path'
		then	
			Backing=$(realpath --relative-to=. $(dirname $Filename)/$(
				echo $Desc | sed "s/.*has backing file (path //; s/).*//"
			) )
			[ -e "$Backing" ] || Backing="$Backing (MISSING)"
		fi
		Running=$( fuser $Filename 2>&1 | cut -d : -f 2- || : )
		printf "%s\t%s\t%s\n" "$Backing" "$Filename" "$Running"
	done | sort -u | python -c '
import sys


def get_width_and_pids(children, print_pids, my_pids, node, depth):
    child_pids = set()
    max_width = depth * 4 + len(node)
    for child in children.get(node, []):
        width, pids = get_width_and_pids(
            children, print_pids, my_pids, child, depth + 1
        )
        child_pids |= pids
        if width > max_width:
            max_width = width
    print_pids[node] = set(my_pids.get(node, [])) - child_pids
    return max_width, my_pids.get(node, set()) | child_pids


def print_tree(children, print_pids, node, prefix, width):
    for i, child in enumerate(sorted(children.get(node, []))):
        if i == len(children[node]) - 1:
            branch, connector = "└", " "
        else:
            branch, connector = "├", "│"
        left = f"{prefix}{branch}── {child}"
        pids = " ".join(print_pids.get(child, []))
        if pids == "":
            print(left)
        else:
            print(f"{left:<{width}} : {pids}")
        print_tree(
            children, print_pids, child, f"{prefix}{connector}   ", width
        )


def main():
    children = {}
    has_parent = []
    my_pids = {}
    print_pids = {}
    for ln in sys.stdin:
        parent, child, pids = ln.split("\t")
        my_pids[child] = set(pids.split())
        children.setdefault(parent, []).append(child)
        has_parent.append(child)
    has_parent = set(has_parent)
    max_width = 0
    for node in children.keys():
        if node not in has_parent:
            width, _ = get_width_and_pids(
                children, print_pids, my_pids, node, 0
            )
            if width > max_width:
                max_width = width
    for node in children.keys():
        if node not in has_parent:
            print(node)
            print_tree(children, print_pids, node, "", max_width)


if __name__ == "__main__":
    main()
'
	exit
fi
[ "$Command" = "run" ] \
	|| die "ERR-002: run 'daiker $Command -h/--help'"
Name=""
Mounts=""
for ((Idx=0; Idx<${#MountDirs[@]}; Idx++))
do
	[ -d ${MountDirs[$Idx]} ] || die "ERR-020: no such dir ${MountDirs[$Idx]}"
	Mounts="$Mounts -virtfs local,id=daiker-$Idx,path=${MountDirs[$Idx]},\
		security_model=none,multidevs=remap,mount_tag=daiker-$Idx"
done
for ((i=0; i<${#EnablePrivateNets[@]}; i++))
do
	if [ "${EnablePrivateNets[$i]}" = "random" ]
	then
		MacAddr=$(printf "52:54:00:%02x:%02x:%02x\n" $(( $RANDOM % 256)) \
			$(( $RANDOM % 256)) $(( $RANDOM % 256)) )
	else
		MacAddr=$(printf "52:54:00:${EnablePrivateNets[$i]}\n")
	fi
	PrvNet+=" -device virtio-net-pci,netdev=n$i,mac=$MacAddr -netdev \
socket,id=n$i,mcast=230.$(($(id -u) % 239)).$(($(id -u) % 241)).\
$(($(id -u) % 251)):$(($(id -u) % 9973 + 30000+$i)),localaddr=127.0.0.1"
done
if [[ ${#TcpPorts[@]} -gt 0 ]]
then
	[ "$DisablePublicNet" != "YES" ] || die "ERR-006: -T cannot be used with -d"
	HostFwd=$( get_hostfwd tcp ${TcpPorts[@]} )
	[ -n "$HostFwd" ] \
		|| die "ERR-016: faield to get a idle tcp port on physical machine"
	echo "TCP ports: $HostFwd"
	PubNet="$PubNet,$HostFwd"
fi
if [[ ${#UdpPorts[@]} -gt 0 ]]
then
	[ "$DisablePublicNet" != "YES" ] \
		|| die "ERR-030: -U cannot be used with -d"
	HostFwd=$( get_hostfwd udp ${UdpPorts[@]} )
	[ -n "$HostFwd" ] \
		|| die "ERR-017: faield to get a idle udp port on physical machine"
	echo "UDP ports: $HostFwd"
	PubNet="$PubNet,$HostFwd"
fi
if [ "$QemuDisplay" = "gtk" ]
then
	set +u
	[ -n "$DISPLAY" ] \
		|| die "ERR-004: '-D gtk' needs X, or you might want to try '-D vnc'"
	set -u
	QemuDisplay="-display gtk -vga std"
elif [ "$QemuDisplay" = "vnc" ]
then
	Vnc=$(get_free_ports tcp 5900 5999 1)
	[ -z "$Vnc" ] && die "ERR-014: no available vnc port"
	echo "VNC port: $Vnc"
	((Vnc=Vnc-5900)) || :
	QemuDisplay="-display vnc=:$Vnc"
elif [ "$QemuDisplay" = "none" ]
then
	QemuDisplay="-display none"
elif [ "$QemuDisplay" = "nographic" ]
then
	QemuDisplay="-nographic"
else
	set +e
	let Vnc="$QemuDisplay" 2> /dev/null
	set -e
	[ "$Vnc" = "$QemuDisplay" ] \
		|| die "ERR-018: -D should be gtk/vnc/none/nographic or a Vnc number"
	QemuDisplay="-display vnc=:$Vnc"
fi
if [ "$DisablePublicNet" = "YES" ]
then
	PubNet=""
fi
if [ -n "$Iso" ]
then
	[ -f "$Iso" ] || die "ERR-008: no such iso file $Iso"
	Iso="-cdrom $Iso"
fi
Drives=""
for Arg in "$@"
do
	if [[ "$Arg" == *"="* ]]; then
		Filename=${Arg%%=*}
		Size=${Arg#*=}
		if [ -f "$Filename" ]
		then
			SizeInArg=$(numfmt --from=iec $Size)
			SizeInFile=$(qemu-img info $Filename | grep "^virtual size:" \
				| sed -E 's/.*\(([0-9]+) bytes\).*/\1/')
			[ "$SizeInArg" = "$SizeInFile" ] \
				|| echo "Warning: specified size for \"$Filename\" \
atches"
		else
			qemu-img create -qf qcow2 $Filename $Size
		fi
	elif [[ "$Arg" == *":"* ]]; then
		Filename=${Arg%%:*}
		Backing=${Arg#*:}
		[ -f "$Backing" ] || die "ERR-019: no such a backing image $Backing"
		if [ ! -f "$Filename" ]
		then
			Dirname=$(dirname $Filename)
			[ -d $Dirname ] || die "ERR-029: no such directory $Dirname"
			qemu-img create -qf qcow2 -b $(realpath \
				--relative-to=$Dirname $Backing) -F qcow2 $Filename
		elif [ "$Backing" != \
			"$(qemu-img info $Filename | grep "^backing file:" \
				| cut -c 15- )" \
		]
		then
			die "ERR-010: The specified backing image for \"$Filename\" is \
\"$Backing\", but command \"qemu-img info $Filename\" reports a differnt \
backing image."
		fi
		[ ! -w $Backing ] \
			|| chmod a-w $Backing \
			|| echo "Warning: Could not set $Backing to read-only. Continuing."
	elif [ -f "$Arg" ]
	then
		Filename=$Arg
	else
		die "ERR-034: no such a file \"$Arg\""
	fi
	[ -n "$Name" ] || Name=$Filename
	Drives="$Drives -drive file=$Filename,format=qcow2"
done
[ -s "$Name" ] || Name=NULL
QemuBin=$(command -v qemu-system-x86_64 2>/dev/null) \
	|| QemuBin="$(command -v qemu-kvm 2>/dev/null)" \
	|| QemuBin="$(command -v /usr/libexec/qemu-kvm 2>/dev/null)" \
	|| die "ERR-031: qemu-system-x86_64 or qemu-kvm is missing"
IFS=$' '
$QemuBin -name $Name -cpu host -enable-kvm -usb -device usb-tablet \
	-smp $Cpu -m ${RamSize}G $Drives $Iso $PrvNet $PubNet $Mounts $QemuDisplay \
	${QemuParameters[@]}
